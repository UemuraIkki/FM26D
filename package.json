{
  "name": "fm26d",
  "version": "0.1.0",
  "private": true,
  "description": "Football league observation simulator (FM26D) - headless CLI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "season": "tsx src/cli/main.ts season",
    "calibrate": "tsx src/cli/main.ts calibrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

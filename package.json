{
  "name": "fm26d",
  "version": "0.1.0",
  "private": true,
  "description": "Football league observation simulator (FM26D) - headless CLI",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "season": "tsx src/cli/main.ts season",
    "calibrate": "tsx src/cli/main.ts calibrate",
    "depth": "tsx src/cli/main.ts depth",
    "play": "tsx src/cli/main.ts play",
    "feed": "tsx src/cli/main.ts feed",
    "watch": "tsx src/cli/main.ts watch",
    "unwatch": "tsx src/cli/main.ts unwatch",
    "watchlist": "tsx src/cli/main.ts watchlist",
    "healthcheck": "tsx src/cli/main.ts healthcheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
